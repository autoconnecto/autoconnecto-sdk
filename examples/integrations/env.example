# Copy to .env and export before running scripts (or pass inline).
API_BASE=https://api.autoconnecto.in
TENANT_ID=00000000-0000-0000-0000-000000000000
WEBHOOK_SECRET=your-tenant-webhook-secret

# Generic webhook — use device token OR device id (not both required)
DEVICE_TOKEN=
DEVICE_ID=

# LoRa samples — must match DevEUI on the Autoconnecto device
DEV_EUI=0102030405060708
