# Copy to raspberrypi/.env and fill in (or export in shell)

AUTOCONNECTO_DEVICE_TOKEN=YOUR_DEVICE_TOKEN

# MQTT (default production broker)
AUTOCONNECTO_MQTT_HOST=mqtt.autoconnecto.in
AUTOCONNECTO_MQTT_PORT=8883

# HTTPS device API
AUTOCONNECTO_API_HOST=api.autoconnecto.in

# TLS: path to ISRG root bundle (default: ca/isrg_roots.pem in this tree)
# AUTOCONNECTO_CA_FILE=

# Set to 1 only on a closed test bench
# AUTOCONNECTO_INSECURE_TLS=0

# Optional relay GPIO (BCM numbering), comma-separated — matches ESP32 examples
# AUTOCONNECTO_RELAY_PINS=2,4,5,18
